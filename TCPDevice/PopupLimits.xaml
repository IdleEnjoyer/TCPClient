<Window x:Class="TCPDevice.PopupLimits"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCPDevice"
        mc:Ignorable="d"
        Title="PopupLimits" Height="180" Width="320">
    <Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="1*"/>
			<RowDefinition Height="1*"/>
			<RowDefinition Height="1*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="1*"/>
			<ColumnDefinition Width="4*"/>
		</Grid.ColumnDefinitions>
		<Label Content="⤒" Grid.Row="0" Grid.Column="0" FontSize="35" HorizontalContentAlignment="Center"/>
		<TextBox x:Name="UpperLim" Grid.Row="0" Grid.Column="1" Margin="0,5,10,5" FontSize="20" VerticalContentAlignment="Center"/>
		<Label Content="⤓" Grid.Row="1" Grid.Column="0" FontSize="35" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
		<TextBox x:Name="LowerLim" Grid.Row="1" Grid.Column="1" Margin="0,5,10,5" FontSize="20" VerticalContentAlignment="Center"/>
		<Button x:Name="Confirm" Content="ОК" Grid.Row="2" Grid.ColumnSpan="2" FontSize="20" Margin="20,10,20,10" Click="Confirm_Click"/>
	</Grid>
</Window>
