<Window x:Class="TCPDevice.AddProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCPDevice"
        mc:Ignorable="d"
        Title="Конструктор" Height="450" Width="600"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="17*"/>
        </Grid.RowDefinitions>
        <Menu x:Name="ControlMenu" Height="25" VerticalAlignment="Top" >
            <MenuItem Header="Файл">
                <MenuItem x:Name="Export" Header="Экспорт" Click="Export_Click"/>
                <MenuItem x:Name="Import" Header="Импорт" Click="Import_Click"/>
            </MenuItem>
            <MenuItem x:Name="AddAxisBttn" Header="Добавить ось" Click="AddAxisBttn_Click"/>
            <MenuItem x:Name="AddPropBttn" Header="Добавить свойство" Click="AddPropBttn_Click"/>
            <MenuItem x:Name="Completion" Header="Закончить" Click="Completion_Click"/>
        </Menu>
        <ScrollViewer x:Name="Viewer" Grid.Row="1" HorizontalScrollBarVisibility="Visible">
            <Grid x:Name="ProjectGrid" ShowGridLines="True" Width="240" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <!--<Label x:Name="AxisName" Content="Ось:" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="0" FontSize="20"/>-->
                <TextBox x:Name="Axis" Text="ОСЬ 1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Column="1" Grid.Row="0" FontSize="16" Margin="0,20,0,0" VerticalAlignment="Bottom" Height="25"/>
                <!--<Button x:Name="RemoveAxis" Content="X" Grid.Column="1" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right" Height="25" Width="25" Click="RemoveAxis_Click"/>-->
                <TextBox x:Name="Prop" Text="СВОЙСТВО 1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="1" FontSize="14" HorizontalAlignment="Left" Margin="0,20,0,0" Width="95" VerticalAlignment="Bottom" Height="25"/>
                <Button x:Name="Incr" Content ="+" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="25" Height="25" FontSize="16" Click="Incr_Click"/>
                <Button x:Name="Decr" Content ="-" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Width="25" Height="25"  FontSize="16" Click="Decr_Click"/>
                <!--<Button x:Name="RemoveProp" Content="X" Grid.Column="0" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Height="25" Width="25" Click="RemoveProp_Click"/>-->
            </Grid>
        </ScrollViewer>

    </Grid>
</Window>
