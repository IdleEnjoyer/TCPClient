<Window x:Class="TCPDevice.AddProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCPDevice"
        mc:Ignorable="d"
        Title="AddProjectWindow" Height="450" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="AddAxisBttn" Content="Добавить Ось" Grid.Column="0" Grid.Row="0" Click="AddAxisBttn_Click" Margin="10,10,10,10"/>
        <Button x:Name="RemoveAxisBttn" Content="УБрать Ось" Grid.Column="1" Grid.Row="0" Margin="10,10,10,10" Click="RemoveAxisBttn_Click"/>
        
        <Button x:Name="AddPropBttn" Content="Добавить Свойство" Grid.Column="2" Grid.Row="0" Click="AddPropBttn_Click" Margin="10,10,10,10"/>
        <Button x:Name="RemovePropBttn" Content="Убрать Свойство" Grid.Column="3" Grid.Row="0" Margin="10,10,10,10" Click="RemovePropBttn_Click"/>
        
        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="4" HorizontalScrollBarVisibility="Visible">
            <Grid x:Name="ProjectGrid" Width="240" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="AxisName" Content="Ось:" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="0" FontSize="20"/>
                <TextBox x:Name="Axis" Text="ОСЬ 1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Column="1" Grid.Row="0" FontSize="20"/>
                <TextBox x:Name="Prop" Text="СВОЙСТВО 1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Column="0" Grid.Row="1" FontSize="14" HorizontalAlignment="Left" Margin="0,10,0,10" Width="90"/>
                <TextBox x:Name="Amount" Text="0" Grid.Column="0" Grid.Row="1" FontSize="16" HorizontalAlignment="Right" VerticalContentAlignment="Center" Margin="0,10,0,10" Width="30" HorizontalContentAlignment="Center"/>
            </Grid>
        </ScrollViewer>
        
    </Grid>
</Window>
