<Window x:Class="TCPDevice.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCPDevice"
        mc:Ignorable="d"
        Title="Клавиатура" Height="340" Width="300" ResizeMode="NoResize" Background="#FFAAB4C8" WindowStyle="ToolWindow">
    <Grid Margin="10,10,10,10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="1*"/>
			<ColumnDefinition Width="1*"/>
			<ColumnDefinition Width="1*"/>
			<ColumnDefinition Width="1*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="1*"/>
			<RowDefinition Height="1*"/>
			<RowDefinition Height="1*"/>
			<RowDefinition Height="1*"/>
		</Grid.RowDefinitions>

		<Button x:Name="Digit_Dot_Btn" Content="." Grid.Row="3" Grid.Column="2" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Btn_Click" FontSize="30"/>
		<Button x:Name="Digit_0_Btn" Content="0" Grid.Row="3" Grid.Column="1" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Btn_Click" FontSize="30">
			<Button.Resources>
				<Style TargetType="Border">
					<Setter Property="CornerRadius" Value="0, 0, 0, 10"/>
				</Style>
			</Button.Resources>
		</Button>
		<Button x:Name="Return_Btn" Content="⏎" Grid.Row="2" Grid.Column="3" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Return_Btn_Click" FontSize="30" Grid.RowSpan="2">
			<Button.Resources>
				<Style TargetType="Border">
					<Setter Property="CornerRadius" Value="0, 0, 10, 0"/>
				</Style>
			</Button.Resources>
		</Button>

		<Button x:Name="Digit_1_Btn" Content="1" Grid.Row="2" Grid.Column="0" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Btn_Click" FontSize="30">
			<Button.Resources>
				<Style TargetType="Border">
					<Setter Property="CornerRadius" Value="0, 0, 0, 10"/>
				</Style>
			</Button.Resources>
		</Button>
		<Button x:Name="Digit_2_Btn" Content="2" Grid.Row="2" Grid.Column="1" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Btn_Click" FontSize="30"/>
		<Button x:Name="Digit_3_Btn" Content="3" Grid.Row="2" Grid.Column="2" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Btn_Click" FontSize="30"/>

		<Button x:Name="Digit_4_Btn" Content="4" Grid.Row="1" Grid.Column="0" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Btn_Click" FontSize="30"/>
		<Button x:Name="Digit_5_Btn" Content="5" Grid.Row="1" Grid.Column="1" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Btn_Click" FontSize="30"/>
		<Button x:Name="Digit_6_Btn" Content="6" Grid.Row="1" Grid.Column="2" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Btn_Click" FontSize="30"/>
		<Button x:Name="Digit_Minus_Btn" Content="-" Grid.Row="1" Grid.Column="3" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Minus_Btn_Click" FontSize="30"/>

		<Button x:Name="Digit_7_Btn" Content="7" Grid.Row="0" Grid.Column="0" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Btn_Click" FontSize="30">
			<Button.Resources>
				<Style TargetType="Border">
					<Setter Property="CornerRadius" Value="10, 0, 0, 0"/>
				</Style>
			</Button.Resources>
		</Button>
		<Button x:Name="Digit_8_Btn" Content="8" Grid.Row="0" Grid.Column="1" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Btn_Click" FontSize="30"/>
		<Button x:Name="Digit_9_Btn" Content="9" Grid.Row="0" Grid.Column="2" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" Click="Digit_Btn_Click" FontSize="30"/>
		<Button x:Name="Digit_Del_Btn" Content="&lt;" Grid.Row="0" Grid.Column="3" Style="{DynamicResource DefBtn}" Foreground="#FFCFCFCF" FontSize="30" Click="Digit_Del_Btn_Click">
			<Button.Resources>
				<Style TargetType="Border">
					<Setter Property="CornerRadius" Value="0, 10, 0, 0"/>
				</Style>
			</Button.Resources>
		</Button>
		
	</Grid>
</Window>
