<Application x:Class="TCPDevice.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TCPDevice"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
		<ResourceDictionary>
			<Style x:Key="DefBtn" TargetType="Button">
				<Setter Property="Background" Value="{DynamicResource NotPressedBtn}"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}" BorderBrush="Gray" BorderThickness="1">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="{DynamicResource PressedBtn}"/>
					</Trigger>
				</Style.Triggers>
			</Style>

			<LinearGradientBrush x:Key="NotPressedBtn" EndPoint="0.5,1" StartPoint="0.5,0">
				<GradientStop Color="Black" Offset="0.5"/>
				<GradientStop Color="#FF7B7B7B" Offset="1"/>
				<GradientStop Color="#FF7B7B7B" Offset="0"/>
			</LinearGradientBrush>

			<LinearGradientBrush x:Key="PressedBtn" EndPoint="0.5,1" StartPoint="0.5,0">
				<GradientStop Color="Black" Offset="0.5"/>
				<GradientStop Color="#FFA7A7A7" Offset="1"/>
				<GradientStop Color="#FFA7A7A7" Offset="0"/>
			</LinearGradientBrush>
				
			
		</ResourceDictionary>
    </Application.Resources>
</Application>
