<Application x:Class="TCPDevice.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TCPDevice"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
		<ResourceDictionary>
			
			<Style x:Key="LightText" TargetType="TextBlock">
				<Setter Property="Foreground" Value="White"/>
				<!--Value="#1E1F29" -->

				<Setter Property="FontFamily" Value="Bahnschrift"/>
			</Style>
			<Style x:Key="LeftPanel_TopText" TargetType="TextBlock">
				<Setter Property="Foreground" Value="White"/>
				<Setter Property="FontWeight" Value="Bold"/>
				<!--Value="#1E1F29" -->

				<Setter Property="FontFamily" Value="Bahnschrift"/>
			</Style>
			<Style x:Key="DefBtn" TargetType="Button">
				<Setter Property="Background" Value="#404258"/>
				<Setter Property="Foreground" Value="White"/>
				<Setter Property="FontFamily" Value="Bahnschrift"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="3" CornerRadius="3">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="#585B79"/>
					</Trigger>
					<Trigger Property="IsPressed" Value="True">
						<Setter Property="Background" Value="LightBlue"/>
					</Trigger>
					<Trigger Property="IsEnabled" Value="False">
						<Setter Property="Background" Value="#60606C"/>
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
    </Application.Resources>
</Application>
