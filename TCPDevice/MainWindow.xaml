<Window x:Class="TCPDevice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TCPDevice"
        mc:Ignorable="d"
		Closing="Window_Closing"
        Title="ТЕСАРТ Сервисное ПО" Height="720" Width="1280" Background="White" MinWidth="1074" MinHeight="624"  Loaded="Window_Loaded">
	<Window.Resources>

	</Window.Resources>
	<TabControl x:Name="Control" Background="#FF585858">
		<TabItem x:Name="Demo_Tab" Header="Демонастрация">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="2*"/>
					<RowDefinition Height="11*"/>
					<RowDefinition Height="2*"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1*"/>
					<ColumnDefinition Width="5*"/>
					<ColumnDefinition Width="2*"/>
				</Grid.ColumnDefinitions>
				<Grid Grid.Row="0" Grid.Column="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*"/>
					</Grid.ColumnDefinitions>
					<Label x:Name="XPos_Label" Content="Позиция: 90.00°" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="34" FontFamily="Bahnschrift"/>
				</Grid>
				<Label x:Name="Slider_Control" Content="Управление" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" FontFamily="Bahnschrift" />
				<GroupBox Grid.Row="1" Grid.Column="1">
					<Viewbox x:Name="viewbox" Margin="0,10,0,10" >
						<Canvas x:Name="Demo_Canvas" Background="#FF969696" Width="540" Height="440">
							<Ellipse Width="200" Height="200" Fill="LightGray" Canvas.Left="170" Canvas.Top="120" Stroke="Black" StrokeThickness="4"/>
							<Line x:Name="PosLine" X1="0" Y1="0" X2="0" Y2="100" Stroke="Black" Canvas.Left="270" Canvas.Top="220" StrokeThickness="4"/>
						</Canvas>
					</Viewbox>
				</GroupBox>

				<Grid Grid.Row="1" Grid.Column="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="4*"/>
						<RowDefinition Height="3*"/>
						<RowDefinition Height="3*"/>
						<RowDefinition Height="3*"/>
						<RowDefinition Height="3*"/>
					</Grid.RowDefinitions>
					<Button x:Name="PowerSwitch_Btn" Style="{DynamicResource DefBtn}" Grid.Row="0" Grid.Column="0" Margin="20,10,0,10" Click="PowerSwitch_Btn_Click">
						<Button.Resources>
							<Style TargetType="Border">
								<Setter Property="CornerRadius" Value="10, 0, 0, 10"/>
							</Style>
						</Button.Resources>
						<Path x:Name="PowerSwitch_Figure" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="Red" UseLayoutRounding="True">
							<Path.Data>
								<PathGeometry Figures="M 50,20 A 30,30 0 1 1 10,20 M 30,5 L 30,30"/>
							</Path.Data>
						</Path>
					</Button>
					<Button x:Name="Stop_Btn" Style="{DynamicResource DefBtn}" Grid.Row="0" Grid.Column="1" Margin="0,10,20,10" Click="Stop_Btn_Click">
						<Button.Resources>
							<Style TargetType="Border">
								<Setter Property="CornerRadius" Value="0, 10, 10, 0"/>
							</Style>
						</Button.Resources>
						<Grid>
							<Path x:Name="StopSign" Stroke="White" StrokeThickness="4" StrokeStartLineCap="Round">
								<Path.Data>
									<PathGeometry Figures="M 20,0 L 40,0 60,20 60,40 40,60 20,60 0,40 0,20 Z M 40,16 L 40,30 M 35,13 L 35,30 M 30,12 L 30,30 M 25,14 L 25,30 M 18,26 L 26,38"/>
								</Path.Data>
								<Path.Fill>
									<SolidColorBrush x:Name="StopSignBrush" Color="#FFA50000"/>
								</Path.Fill>
							</Path>
							<Rectangle Fill="White" Margin="23,27,21,26"/>
							<Ellipse Fill="White" RenderTransformOrigin="0.606,0.52" Margin="22,27,21,17" Height="18" Width="20"/>
						</Grid>

						<Button.Triggers>
							<EventTrigger RoutedEvent="Button.Click">
								<BeginStoryboard>
									<Storyboard>
										<ColorAnimationUsingKeyFrames Storyboard.TargetName="StopSignBrush" Storyboard.TargetProperty="Color" Duration="0:0:0.5">
											<ColorAnimationUsingKeyFrames.KeyFrames>
												<LinearColorKeyFrame Value="Red" KeyTime="0:0:0"/>
												<LinearColorKeyFrame Value="#FFA50000" KeyTime="0:0:0.5"/>
											</ColorAnimationUsingKeyFrames.KeyFrames>
										</ColorAnimationUsingKeyFrames>
									</Storyboard>
								</BeginStoryboard>
							</EventTrigger>
						</Button.Triggers>
					</Button>
					<TextBox x:Name="MovePos" Grid.Row="1" Grid.Column="0" Text="90.0" Margin="10,25,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="36">
						<TextBox.Resources>
							<Style TargetType="Border">
								<Setter Property="CornerRadius" Value="10, 0, 0, 0"/>
							</Style>
						</TextBox.Resources>
					</TextBox>
					<TextBox x:Name="MoveSpd" Grid.Row="1" Grid.Column="1" Text="15.0" Margin="0,25,10,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="36">
						<TextBox.Resources>
							<Style TargetType="Border">
								<Setter Property="CornerRadius" Value="0, 10, 0, 0"/>
							</Style>
						</TextBox.Resources>
					</TextBox>
					<Button x:Name="MoveBtn" Content="Движение" Style="{DynamicResource DefBtn}" Foreground="White" Grid.Row="2" Grid.ColumnSpan="2" Margin="10,0,10,25" Click="MoveBtn_Click" FontSize="36">
						<Button.Resources>
							<Style TargetType="Border">
								<Setter Property="CornerRadius" Value="0, 0, 10, 10"/>
							</Style>
						</Button.Resources>
					</Button>
					<TextBox x:Name="StepSize" Grid.Row="3" Grid.Column="0" Text="30.0" Margin="10,25,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="36" >
						<TextBox.Resources>
							<Style TargetType="Border">
								<Setter Property="CornerRadius" Value="10, 0, 0, 0"/>
							</Style>
						</TextBox.Resources>
					</TextBox>
					<TextBox x:Name="StepSpd" Grid.Row="3" Grid.Column="1" Text="15.0" Margin="0,25,10,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="36">
						<TextBox.Resources>
							<Style TargetType="Border">
								<Setter Property="CornerRadius" Value="0, 10, 0, 0"/>
							</Style>
						</TextBox.Resources>
					</TextBox>
					<Button x:Name="StepBtn" Content="Шаги" Style="{DynamicResource DefBtn}" Foreground="White" Grid.Row="4" Grid.ColumnSpan="2" Margin="10,0,10,25" Click="StepBtn_Click" FontSize="36" >
						<Button.Resources>
							<Style TargetType="Border">
								<Setter Property="CornerRadius" Value="0, 0, 10, 10"/>
							</Style>
						</Button.Resources>
					</Button>
				</Grid>
			</Grid>
		</TabItem>
	</TabControl>
</Window>
