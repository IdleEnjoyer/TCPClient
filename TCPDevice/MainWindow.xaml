<Window x:Class="TCPDevice.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:TCPDevice"
		mc:Ignorable="d"
		Title="MainWindow" Height="490" Width="800" Background="#FFC9C9C9"
        Closing="Window_Closing">
    <TabControl>
        <TabItem Header="Ethernet">
            <Grid Background="#FFBDBDBD">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="7*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <TabControl x:Name="TabProgram" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="Gray" Margin="0,25,0,0">
                    <TabItem x:Name="ConnectionTCP" Header="Подключение">
                        <Grid Background="#FFBDBDBD">
                            <Viewbox x:Name="ConnectionView" Grid.Row="1">
                                <Grid x:Name="ConnectionGrid" HorizontalAlignment="Center" Height="325">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3*"/>
                                        <RowDefinition Height="3*"/>
                                        <RowDefinition Height="3*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="3*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="4*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label x:Name="ConnectionStatusLabel" Content="Соединение: " Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="24"/>
                                    <Label x:Name="ConnectionStatus" Content="Отключено" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="Red"/>

                                    <Button x:Name="StartConnection" Content="Подключиться"  Grid.Row="5" Margin="10,10,10,10" FontSize="16" Click="StartConnection_Click"/>
                                    <Button x:Name="StopConnection" Content="Отключиться"  Grid.Column="1" Grid.Row="5" Width="164" Margin="10,10,10,10" FontSize="16" Click="StopConnection_Click"/>

                                    <Label x:Name="IPLabel" Content="IP:" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="24" Grid.Row="1" Height="40" Width="35"/>
                                    <TextBox x:Name="IPInput" TextWrapping="Wrap" Text="192.168.0.101" FontSize="24" TextAlignment="Justify" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,10,0,10"/>

                                    <TextBox x:Name="PortInput" TextWrapping="Wrap" Text="23" FontSize="24" TextAlignment="Justify" Grid.Column="1" Grid.Row="2" VerticalContentAlignment="Center" Margin="0,10,0,10"/>
                                    <Label x:Name="PortLabel" Content="Port:" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="24" Grid.Row="2" Height="42" Width="58"/>

                                </Grid>
                            </Viewbox>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="DeviceTab" Header="Добавить Устр-во">
                        <Button x:Name="AddTab" Width="200" Height="50" Content="Добавить проект" FontSize="20" Click="AddTab_Click" />
                    </TabItem>
                    <TabItem x:Name="TimerTab" Header="Таймер">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="14*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Menu Height="25" VerticalAlignment="Top" Grid.ColumnSpan="4">
                                <MenuItem x:Name="TimerStart" Header="Старт" Click="TimerStart_Click" FontSize="14"/>
                                <MenuItem x:Name="TimerStop" Header="Стоп" Click="TimerStop_Click" FontSize="14"/>
                                <MenuItem x:Name="Import" Header="Импорт" Click="Import_Click" FontSize="14"/>
                                <MenuItem x:Name="Export" Header="Экспорт" Click="Export_Click" FontSize="14"/>
                            </Menu>
                            <Label x:Name="TimerLabel" Content="Время" FontSize="20" Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Grid x:Name="CommandGrid" Margin="20,40,20,10" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22*"/>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="5*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="12*"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="DemoCommandInput" Height="20" Grid.Row="0" Grid.Column="0" />
                                <TextBox x:Name="DemoTimerInput" Height="20" Grid.Row="0" Grid.Column="1" PreviewTextInput="TMR_PreviewTextInput"/>
                                <Button x:Name="AddCommand" Height="20" Grid.Row="0" Grid.Column="2" Content="Добавить" Click="AddCommand_Click"/>
                                <ListView x:Name="DemoCommandList" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding Commands}" d:ItemsSource="{d:SampleData ItemCount=5}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel x:Name="CMDList" Orientation="Horizontal">
                                                <TextBox x:Name="CMD" Text="{Binding CMD, Mode=TwoWay}"/>
                                                <TextBox x:Name="TMR" Text="{Binding TMR, Mode=TwoWay}" PreviewTextInput="TMR_PreviewTextInput"/>
                                                <Button x:Name="DeleteItem" Content="✖" Click="DeleteItem_Click" Initialized="DeleteItem_Initialized"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>

                    </TabItem>
                </TabControl>
                <Grid x:Name="ChatGrid" Grid.Column="1" Grid.RowSpan="2" Margin="0,24.8,0,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="1  *"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerData" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" IsReadOnly="True" FontFamily="Global Monospace" Grid.ColumnSpan="2" Grid.Row="0" Margin="0,0,0,60" />
                    <Button x:Name="SendCmd" Height="20" Content="Отправить" FontSize="10" Margin="0,0,0,40" Click="SendCmd_Click" Grid.Column="1" Grid.Row="1" VerticalAlignment="Bottom"/>
                    <TextBox x:Name="CommandInput" Height="20" TextWrapping="Wrap" Margin="0,0,0,40" KeyDown="OnPress" Grid.Row="1" VerticalAlignment="Bottom"/>
                    <Button x:Name="SendCmd1" Height="20" Content="Отправить" FontSize="10" Margin="0,0,0,20" Click="SendCmd_Click" Grid.Column="1" Grid.Row="2" VerticalAlignment="Bottom"/>
                    <TextBox x:Name="CommandInput1" Height="20" TextWrapping="Wrap" Margin="0,0,0,20" KeyDown="OnPress" Grid.Row="2" VerticalAlignment="Bottom" />
                    <Button x:Name="SendCmd2" Height="20" Content="Отправить" FontSize="10" Margin="0,0,0,0" Click="SendCmd_Click" Grid.Column="1" Grid.Row="3" VerticalAlignment="Bottom"/>
                    <TextBox x:Name="CommandInput2" Height="20" TextWrapping="Wrap" Margin="0,0,0,0" KeyDown="OnPress" Grid.Row="3" VerticalAlignment="Bottom"/>
                </Grid>
                <Menu Height="25" Grid.ColumnSpan="2" VerticalAlignment="Top" MinHeight="25">
                    <MenuItem Header="Устройство" Margin="0,3,0,0">
                        <MenuItem x:Name="Create" Header="Создать" Click="AddTab_Click"/>
                        <MenuItem x:Name="Open" Header="Открыть" Click="Open_Click"/>
                        <MenuItem x:Name="Save" Header="Сохранить" Click="Save_Click"/>
                        <MenuItem x:Name="Redact" Header="Редактировать" Click="Redact_Click"/>
                    </MenuItem>
                    <MenuItem Header="IP: " Margin="0,3,0,0"/>
                    <MenuItem x:Name="IP" Header="" Margin="0,3,0,0"/>
                    <MenuItem x:Name="StartSymbol" Header="Символ начала:" Margin="0,3,0,0"/>
                    <TextBox x:Name="StartSymbolInput" Width="40" Text="^" Margin="0,3,0,0"/>
                    <MenuItem x:Name="EndSymbol" Header="Символ конца:" Margin="0,3,0,0"/>
                    <TextBox x:Name="EndSymbolInput" Width="40" Text="\r\n" Margin="0,3,0,0"/>
                </Menu>
            </Grid>
        </TabItem>
        <TabItem Header="Serial">
            <Grid Background="#FFBDBDBD">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="7*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <TabControl x:Name="TabProgramCom" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="Gray" Margin="0,25,0,0">
                    <TabItem x:Name="DeviceTabCom" Header="Добавить Устр-во">
                        <Button x:Name="AddCom" Width="200" Height="50" Content="Добавить проект" FontSize="20" Click="AddCom_Click" />
                    </TabItem>
                    <TabItem x:Name="TimerTabCom" Header="Таймер">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="14*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Menu Height="25" VerticalAlignment="Top" Grid.ColumnSpan="4">
                                <MenuItem x:Name="TimerStartCom" Header="Старт" Click="TimerStart_Click" FontSize="14"/>
                                <MenuItem x:Name="TimerStopCom" Header="Стоп" Click="TimerStop_Click" FontSize="14"/>
                                <MenuItem x:Name="ImportCom" Header="Импорт" Click="Import_Click" FontSize="14"/>
                                <MenuItem x:Name="ExportCom" Header="Экспорт" Click="Export_Click" FontSize="14"/>
                            </Menu>
                            <Label x:Name="TimerLabelCom" Content="Время" FontSize="20" Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Grid x:Name="CommandGridCom" Margin="20,40,20,10" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22*"/>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="5*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="12*"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="DemoCommandInputCom" Height="20" Grid.Row="0" Grid.Column="0" />
                                <TextBox x:Name="DemoTimerInputCom" Height="20" Grid.Row="0" Grid.Column="1" PreviewTextInput="TMR_PreviewTextInput"/>
                                <Button x:Name="AddCommandCom" Height="20" Grid.Row="0" Grid.Column="2" Content="Добавить" Click="AddCommandCom_Click"/>
                                <ListView x:Name="DemoCommandListCom" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding CommandsSerial}" d:ItemsSource="{d:SampleData ItemCount=5}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel x:Name="CMDListCom" Orientation="Horizontal">
                                                <TextBox x:Name="CMDSerial" Text="{Binding CMD, Mode=TwoWay}"/>
                                                <TextBox x:Name="TMRSerial" Text="{Binding TMR, Mode=TwoWay}" PreviewTextInput="TMR_PreviewTextInput"/>
                                                <Button x:Name="DeleteItemCom" Content="✖" Click="DeleteItemCom_Click" Initialized="DeleteItemCom_Initialized"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>

                    </TabItem>
                </TabControl>
                <Grid x:Name="ChatGridCom" Grid.Column="1" Grid.RowSpan="2" Margin="0,24.8,0,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="1  *"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ComData" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" IsReadOnly="True" FontFamily="Global Monospace" Grid.ColumnSpan="2" Grid.Row="0" Margin="0,0,0,60" />
                    <Button x:Name="ComSend0" Height="20" Content="Отправить" FontSize="10" Margin="0,0,0,40" Click="ComSend_Click" Grid.Column="1" Grid.Row="1" VerticalAlignment="Bottom"/>
                    <TextBox x:Name="ComInput0" Height="20" TextWrapping="Wrap" Margin="0,0,0,40" KeyDown="ComInput_KeyDown" Grid.Row="1" VerticalAlignment="Bottom"/>
                    <Button x:Name="ComSend1" Height="20" Content="Отправить" FontSize="10" Margin="0,0,0,20" Click="ComSend_Click" Grid.Column="1" Grid.Row="2" VerticalAlignment="Bottom"/>
                    <TextBox x:Name="ComInput1" Height="20" TextWrapping="Wrap" Margin="0,0,0,20" KeyDown="ComInput_KeyDown" Grid.Row="2" VerticalAlignment="Bottom" />
                    <Button x:Name="ComSend2" Height="20" Content="Отправить" FontSize="10" Margin="0,0,0,0" Click="ComSend_Click" Grid.Column="1" Grid.Row="3" VerticalAlignment="Bottom"/>
                    <TextBox x:Name="ComCommand2" Height="20" TextWrapping="Wrap" Margin="0,0,0,0" KeyDown="ComInput_KeyDown" Grid.Row="3" VerticalAlignment="Bottom"/>
                </Grid>
                <Menu Height="25" Grid.ColumnSpan="2" VerticalAlignment="Top" MinHeight="25">
                    <MenuItem Header="Устройство" Margin="0,3,0,0">
                        <MenuItem x:Name="CreateCom" Header="Создать" Click="AddCom_Click"/>
                        <MenuItem x:Name="OpenCom" Header="Открыть" Click="Open_Click"/>
                        <MenuItem x:Name="SaveCom" Header="Сохранить" Click="Save_Click"/>
                        <MenuItem x:Name="RedactCom" Header="Редактировать" Click="Redact_Click"/>
                    </MenuItem>
                    <!--<MenuItem x:Name="StartSymbolCom" Header="Символ начала:" Margin="0,3,0,0"/>
                    <TextBox x:Name="StartSymbolComInput" Width="40" Text="^" Margin="0,3,0,0"/>
                    <MenuItem x:Name="EndSymbolCom" Header="Символ конца:" Margin="0,3,0,0"/>
                    <TextBox x:Name="EndSymbolComInput" Width="40" Text="\r\n" Margin="0,3,0,0"/>-->
                    <MenuItem Header="Порт:"/>
                    <ComboBox Name="PortNumber" SelectionChanged="PortNumber_SelectionChanged" ItemsSource="{Binding AvailablePorts}"/>
                    <MenuItem Name="PortOpened" Header="Открыт: "/>
                    <MenuItem Name="Reconnect" Header="Подключиться" Click="Reconnect_Click"/>
                </Menu>
            </Grid>
            <!--<Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Menu Height="25" VerticalAlignment="Top" MinHeight="25">
                    <MenuItem Header="Порт:"/>
                    <ComboBox Name="PortNumber" SelectionChanged="PortNumber_SelectionChanged" ItemsSource="{Binding AvailablePorts}"/>
                    <MenuItem Name="PortOpened" Header="Opened: "/>
                </Menu>
                <TextBox x:Name="ComData" Margin="0,25,0,25" IsReadOnly="True" VerticalScrollBarVisibility="Visible"/>
                <TextBox x:Name="ComInput" Height="25" VerticalAlignment="Bottom" KeyDown="ComInput_KeyDown" Margin="0,0,40,0"/>
                <Button x:Name="ComSend" Height="25" VerticalAlignment="Bottom" Content="Send" Click="ComSend_Click" Width="40" HorizontalAlignment="Right"/>
            </Grid>-->
        </TabItem>
    </TabControl>

</Window>
