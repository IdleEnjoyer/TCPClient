							<TextBox x:Name="OPU2_YTarSpd" Width="140" Text="20.0" Grid.Column="3" FontSize="30" VerticalAlignment="Center" HorizontalContentAlignment="Center" ToolTip="Скорость" TouchDown="OPU1_TextBox_TouchDown"/>
							<TextBlock Style="{DynamicResource TB}" Text="мм/c" VerticalAlignment="Center" FontSize="24" HorizontalAlignment="Left" Margin="5,0,0,0" />
						</StackPanel>
						<Grid x:Name="OPU2_YPosControl" Grid.Row="2"  Grid.Column="4">
							<Grid.RowDefinitions>
								<RowDefinition Height="1*"/>
								<RowDefinition Height="1*"/>
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1*"/>
								<ColumnDefinition Width="1*"/>
								<ColumnDefinition Width="1*"/>
							</Grid.ColumnDefinitions>
							<Button x:Name="OPU2_YJogLeft" Content="←" Grid.Row="0" Grid.Column="0" FontSize="35" HorizontalContentAlignment="Center" Margin="0,5,0,0" PreviewMouseLeftButtonDown="OPU2_YJogLeft_PreviewMouseLeftButtonDown"  PreviewMouseLeftButtonUp="OPU2_YJogLeft_PreviewMouseLeftButtonUp"  Style="{DynamicResource DefBtn}"  FontFamily="Global User Interface" TouchDown="OPU2_YJogLeft_TouchDown" TouchLeave="OPU2_YJogLeft_TouchLeave">
								<Button.Resources>
									<Style TargetType="Border">
										<Setter Property="CornerRadius" Value="10, 0, 0, 0"/>
									</Style>
								</Button.Resources>
							</Button>
							<Button x:Name="OPU2_YMove" Content="⨀" Grid.Row="0" Grid.Column="1" FontSize="35" HorizontalContentAlignment="Center" Margin="0,5,0,0" Click="OPU2_YMove_Click" Style="{DynamicResource DefBtn}"  FontFamily="Global User Interface"/>
							<Button x:Name="OPU2_YJogRight" Content="→" Grid.Row="0" Grid.Column="2" FontSize="35" HorizontalContentAlignment="Center" Margin="0,5,0,0" PreviewMouseLeftButtonDown="OPU2_YJogRight_PreviewMouseLeftButtonDown"  PreviewMouseLeftButtonUp="OPU2_YJogRight_PreviewMouseLeftButtonUp"  Style="{DynamicResource DefBtn}"  FontFamily="Global User Interface" TouchDown="OPU2_YJogRight_TouchDown" TouchLeave="OPU2_YJogRight_TouchLeave">
								<Button.Resources>
									<Style TargetType="Border">
										<Setter Property="CornerRadius" Value="0, 10, 0, 0"/>
									</Style>
								</Button.Resources>
							</Button>
							<Button x:Name="OPU2_YStop" Content="СТОП" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" FontSize="30" HorizontalContentAlignment="Center" Click="OPU2_YStop_Click" Style="{DynamicResource DefBtn}" >
								<Button.Resources>
									<Style TargetType="Border">
										<Setter Property="CornerRadius" Value="0, 0, 10, 10"/>
									</Style>
								</Button.Resources>
							</Button>
						</Grid>
						<Grid Grid.Column="5">
							<Grid.RowDefinitions>
								<RowDefinition Height="1*"/>
								<RowDefinition Height="1*"/>
							</Grid.RowDefinitions>
							<Label x:Name="OPU2_YLimitsLabel" Content="[ 0.0 ; 1.0 ]" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							<Button x:Name="OPU2_YSetLimit" Content="Изменить" Grid.Row="1" Style="{DynamicResource DefBtn}" FontSize="26" HorizontalAlignment="Center" Width="150" Click="OPU2_YSetLim_Click"/>
						</Grid>

					</Grid>
				</GroupBox>
			</Grid>
		</TabItem>
	</TabControl>
</Window>
