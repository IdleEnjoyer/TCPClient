<Window x:Class="TCPDevice.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:TCPDevice"
		mc:Ignorable="d"
		Title="MainWindow" Height="490" Width="800" Background="#FFC9C9C9"
        Closing="Window_Closing">
    <TabControl>
        <TabItem Header="Подключение">
            <Grid Background="#FFBDBDBD">
                <Viewbox x:Name="ConnectionView" Grid.Row="1">
                    <Grid x:Name="ConnectionGrid" HorizontalAlignment="Center" Height="325">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>

                        <Label x:Name="ConnectionStatusLabel" Content="Соединение: " Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="24"/>
                        <Label x:Name="ConnectionStatus" Content="Отключено" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="Red"/>

                        <Button x:Name="StartConnection" Content="Подключиться"  Grid.Row="5" Margin="10,10,10,10" FontSize="16" Click="StartConnection_Click"/>
                        <Button x:Name="StopConnection" Content="Отключиться"  Grid.Column="1" Grid.Row="5" Width="164" Margin="10,10,10,10" FontSize="16" Click="StopConnection_Click"/>

                        <Label x:Name="IPLabel" Content="IP:" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="24" Grid.Row="2" Height="40" Width="35"/>
                        <TextBox x:Name="IPInput" TextWrapping="Wrap" Text="192.168.0.101" FontSize="24" TextAlignment="Justify" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,10,0,10"/>

                        <TextBox x:Name="PortInput" TextWrapping="Wrap" Text="23" FontSize="24" TextAlignment="Justify" Grid.Column="1" Grid.Row="3" VerticalContentAlignment="Center" Margin="0,10,0,10"/>
                        <Label x:Name="PortLabel" Content="Port:" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="24" Grid.Row="3" Height="42" Width="58"/>


                        <Label x:Name="ConnectionLabel" Content="TCP Клиент: Демонстрации" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Height="42" Grid.ColumnSpan="2" Width="282" HorizontalContentAlignment="Center"/>

                    </Grid>
                </Viewbox>
            </Grid>
        </TabItem>
        <TabItem Header="Устройство">
            <Grid Background="#FFBDBDBD">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="7*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <TabControl x:Name="TabProgram" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="Gray" Margin="0,25,0,0">
                    <TabItem x:Name="DeviceTab" Header="Добавить Устр-во">
                        <Button x:Name="AddTab" Width="200" Height="50" Content="Добавить проект" FontSize="20" Click="AddTab_Click" />
                    </TabItem>
                    <TabItem x:Name="TimerTab" Header="Таймер">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="14*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Menu Height="25" VerticalAlignment="Top" Grid.ColumnSpan="4">
                                <Button x:Name="TimerStart" Content="Старт" Click="TimerStart_Click" FontSize="14"/>
                                <Button x:Name="TimerStop" Content="Стоп" Click="TimerStop_Click" FontSize="14"/>
                                <Button x:Name="Import" Content="Импорт" Click="Import_Click" FontSize="14"/>
                                <Button x:Name="Export" Content="Экспорт" Click="Export_Click" FontSize="14"/>

                            </Menu>
                            <Label x:Name="TimerLabel" Content="Время" FontSize="20" Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Top"/>



                            <Grid x:Name="CommandGrid" Margin="20,40,20,10" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22*"/>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="5*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="12*"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="DemoCommandInput" Height="20" Grid.Row="0" Grid.Column="0" />
                                <TextBox x:Name="DemoTimerInput" Height="20" Grid.Row="0" Grid.Column="1" PreviewTextInput="TMR_PreviewTextInput"/>
                                <Button x:Name="AddCommand" Height="20" Grid.Row="0" Grid.Column="2" Content="Добавить" Click="AddCommand_Click"/>
                                <ListView x:Name="DemoCommandList" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding Commands}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel x:Name="CMDList" Orientation="Horizontal">
                                                <TextBox x:Name="CMD" Text="{Binding CMD}"/>
                                                <TextBox x:Name="TMR" Text="{Binding TMR}" PreviewTextInput="TMR_PreviewTextInput"/>
                                                <Button x:Name="DeleteItem" Content="✖" Click="DeleteItem_Click" Initialized="DeleteItem_Initialized"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>

                    </TabItem>
                </TabControl>
                <Grid x:Name="ChatGrid" Grid.Column="1" Grid.RowSpan="2" Margin="0,24.8,0,0" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="19*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="1  *"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ServerData" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" IsReadOnly="True" FontFamily="Global Monospace" Grid.ColumnSpan="2" Grid.Row="0"/>
                    <Button x:Name="SendCmd" Height="20" Content="Отправить" FontSize="10" Margin="0,0,0,0" Click="SendCmd_Click" Grid.Column="1" Grid.Row="1"/>
                    <TextBox x:Name="CommandInput" Height="20" TextWrapping="Wrap" Margin="0,0,0,0" KeyDown="OnPress" Grid.Row="1"/>
                    <Button x:Name="SendCmd1" Height="20" Content="Отправить" FontSize="10" Margin="0,0,0,0" Click="SendCmd_Click" Grid.Column="1" Grid.Row="2"/>
                    <TextBox x:Name="CommandInput1" Height="20" TextWrapping="Wrap" Margin="0,0,0,0" KeyDown="OnPress" Grid.Row="2" />
                    <Button x:Name="SendCmd2" Height="20" Content="Отправить" FontSize="10" Margin="0,0,0,0" Click="SendCmd_Click" Grid.Column="1" Grid.Row="3"/>
                    <TextBox x:Name="CommandInput2" Height="20" TextWrapping="Wrap" Margin="0,0,0,0" KeyDown="OnPress" Grid.Row="3"/>
                </Grid>
                <Menu Height="25" Grid.ColumnSpan="2" VerticalAlignment="Top">
                    <MenuItem Header="Устройство" Margin="0,3,0,0">
                        <MenuItem x:Name="Create" Header="Создать" Click="AddTab_Click"/>
                        <MenuItem x:Name="Open" Header="Открыть" Click="Open_Click"/>
                        <MenuItem x:Name="Save" Header="Сохранить" Click="Save_Click"/>
                        <MenuItem x:Name="Redact" Header="Редактировать" Click="Redact_Click"/>
                    </MenuItem>
                    <MenuItem Header="IP: " Margin="0,3,0,0"/>
                    <MenuItem x:Name="IP" Header="" Margin="0,3,0,0"/>
                    <MenuItem x:Name="StartSymbol" Header="Символ начала:" Margin="0,3,0,0"/>
                    <TextBox x:Name="StartSymbolInput" Width="40" Text="^" Margin="0,3,0,0"/>
                    <MenuItem x:Name="EndSymbol" Header="Символ конца:" Margin="0,3,0,0"/>
                    <TextBox x:Name="EndSymbolInput" Width="40" Text="\r\n" Margin="0,3,0,0"/>
                </Menu>
            </Grid>
        </TabItem>
        <TabItem Header="Servotronix">
            <Menu Height="25" VerticalAlignment="Top">
                <MenuItem Header="Порт:"/>
                <ComboBox Name="PortNumber"/>
            </Menu>
        </TabItem>
    </TabControl>

</Window>
