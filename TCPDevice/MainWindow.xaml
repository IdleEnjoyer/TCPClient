									<TextBlock Style="{DynamicResource LightText}" Text="Проверка требований к режиму работы ОМС" FontSize="26" TextWrapping="Wrap"/>
									<Separator Margin="0,5,0,5" Background="#FFD6D6D6"/>
									<TextBlock Style="{DynamicResource LightText}" Text="Общий прогресс:" FontSize="30"/>
									<ProgressBar x:Name="Attest_Variant_OpModeReq_TotalProgress" Width="600" Height="32" HorizontalAlignment="Left" Foreground="#404258" Maximum="4" ValueChanged="TotalProgressBar_ValueChanged"/>
									<TextBlock Style="{DynamicResource LightText}" Text="Текущий прогресс:" FontSize="30"/>
									<ProgressBar x:Name="Attest_Variant_OpModeReq_StepProgress" Width="600" Height="32" HorizontalAlignment="Left" Foreground="#404258" Maximum="72"/>

									<Separator Margin="0,5,0,5" Background="#FFD6D6D6"/>
									<Grid Width="450" Height="75" HorizontalAlignment="Left">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="1*"/>
											<ColumnDefinition Width="1*"/>
											<ColumnDefinition Width="1*"/>
										</Grid.ColumnDefinitions>
										<Button x:Name="Attest_Variant_OpModeReq_Start" Style="{DynamicResource DefBtn}" Grid.Column="0" Width="120" Height="60" Content="Старт" FontSize="24" Click="Attest_Variant_DigMeasSystErr_Start_Click"/>
										<Button x:Name="Attest_Variant_OpModeReq_Next" Style="{DynamicResource DefBtn}" Grid.Column="1" Width="120" Height="60" Content="Далее" FontSize="24" Click="Attest_Variant_DigMeasSystErr_Next_Click"/>
										<Button x:Name="Attest_Variant_OpModeReq_Stop" Style="{DynamicResource DefBtn}" Grid.Column="2" Width="120" Height="60" Content="Стоп" FontSize="24" Click="Attest_Variant_DigMeasSystErr_Stop_Click"/>
									</Grid>

								</StackPanel>
							</Grid>
						</TabItem>
					</TabControl>
				</StackPanel>

			</TabItem>
		</TabControl>
	</DockPanel>

</Window>
