						</StackPanel>
						<StackPanel Orientation="Horizontal" Grid.Column="3">
							<TextBox x:Name="OPU1_AzTarSpd" Width="140"  Text="6.0" Grid.Column="3" FontSize="30" VerticalAlignment="Center" HorizontalContentAlignment="Center" ToolTip="Скорость" TouchDown="OPU1_TextBox_TouchDown" TextChanged="OPU1_Speed_TextChanged"/>
