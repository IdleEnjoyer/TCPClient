<Window x:Class="TCPDevice.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:TCPDevice"
		mc:Ignorable="d"
		Title="MainWindow" Height="490" Width="800" Background="#FFC9C9C9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="7*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="70*"/>
        </Grid.ColumnDefinitions>
        <Viewbox x:Name="ConnectionView" Grid.Row="1">
            <Grid x:Name="ConnectionGrid" HorizontalAlignment="Center" Height="325">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="StartConnection" Content="Подключиться" Click="StartConnection_Click" Grid.Row="5" Margin="10,10,10,10" FontSize="16"/>
                <Label x:Name="ConnectionStatus" Content="Отключен" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="Red" Grid.Column="1" Height="42" Width="167"/>
                <Label x:Name="IPLabel" Content="IP:" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="24" Grid.Row="1" Height="40" Width="35"/>
                <TextBox x:Name="IPInput" TextWrapping="Wrap" Text="192.168.0.101" FontSize="24" TextAlignment="Justify" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center"/>
                <TextBox x:Name="PortInput" TextWrapping="Wrap" Text="23" FontSize="24" TextAlignment="Justify" Grid.Column="1" Grid.Row="2" VerticalContentAlignment="Center"/>
                <Label x:Name="PortLabel" Content="Port:" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="24" Grid.Row="2" Height="42" Width="58"/>
                <Button x:Name="StopConnection" Content="Отключиться" Click="StopConnection_Click" Grid.Column="1" Grid.Row="5" Width="164" Margin="10,10,10,10" FontSize="16"/>
                <Label x:Name="ConnectionLabel" Content="Соединение:" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="22" Height="42" Width="137"/>
                <Label Content="Символ конца:" HorizontalAlignment="Left" Grid.Row="4" VerticalAlignment="Center" FontSize="24" Height="40" Width="174"/>
                <TextBox x:Name="EndInput" Grid.Row="4" TextWrapping="Wrap" Text="\r\n" FontSize="24" Grid.Column="1" VerticalContentAlignment="Center"/>
                <Label Content="Символ начала:" HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Center" FontSize="24"/>
                <TextBox x:Name="StartInput" Grid.Column="1" Grid.Row="3" TextWrapping="Wrap" FontSize="24" VerticalContentAlignment="Center" Text="^" />
            </Grid>
        </Viewbox>
        <Viewbox x:Name="TitleView" Margin="0,0,0,0" Grid.Row="0">
            <Label x:Name="DeviceHeader" Content="TCP Клиент" FontSize="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="82" Width="364"/>
        </Viewbox>
        <Viewbox x:Name="PolarisationView" Grid.Column="1" Margin="0,0,0,0" Grid.Row="0" >
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="269">
                <Border Height="55" HorizontalAlignment="Left" VerticalAlignment="Center" Width="235" Margin="24,0,0,0" BorderBrush="Black" BorderThickness="1,1,1,1" Background="#FFDDDDDD" >
                    <CheckBox x:Name="EnabledCheckBox" Content="Питание" FontSize="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" UseLayoutRounding="False" Checked="EnabledCheckBox_Checked" Unchecked="EnabledCheckBox_Checked" BorderThickness="1,1,1,1"/>
                </Border>
                <ComboBox x:Name="PolarisationCmd" HorizontalAlignment="Left" Height="55" VerticalAlignment="Center" Width="19" Margin="5,0,0,0" SelectionChanged="OnSelect">
                    <ComboBox IsSynchronizedWithCurrentItem="False" SelectedIndex="0" Text="Выключение" SelectionChanged="OnSelect" >
                        <Label Content="Выключение"/>
                        <TextBox Text="DIS"/>
                    </ComboBox>
                    <ComboBox SelectedIndex="0" SelectionChanged="OnSelect" >
                        <Label Content="Включение"/>
                        <TextBox Text="EN"/>
                    </ComboBox>
                </ComboBox>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Column="1" Grid.Row="1">
            <Grid x:Name="CmdGrid" VerticalAlignment="Top" Height="342">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AbortBtn" Content="STOP" Click="AbortBtn_Click" Grid.Column="1" Grid.Row="8" Grid.ColumnSpan="2" Margin="43,0,42,0"/>

                <TextBox x:Name="MoveInput1" TextWrapping="Wrap" Text="5,0" FontSize="12" Grid.Column="1" Margin="10,0,10,0" Grid.Row="1" VerticalContentAlignment="Center" Width="65" VerticalAlignment="Center"/>
                <TextBox x:Name="MoveInput2" TextWrapping="Wrap" Text="5,0" FontSize="12" Grid.Column="2" Margin="10,0,10,0" Grid.Row="1" VerticalContentAlignment="Center" Width="65" VerticalAlignment="Center"/>

                <TextBox x:Name="SpeedInput1" TextWrapping="Wrap" Text="5,0" FontSize="12" Grid.Column="1" Margin="10,0,10,0" Grid.Row="2" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
                <TextBox x:Name="SpeedInput2" TextWrapping="Wrap" Text="5,0" FontSize="12" Grid.Column="2" Margin="10,0,10,0" Grid.Row="2" VerticalContentAlignment="Center" VerticalAlignment="Center"/>

                <Button x:Name="LeftStep1" Grid.Column="1" Grid.Row="3" Width="25" HorizontalAlignment="Center" Margin="0,0,30,0" Content="←" FontSize="14" Click="LeftStep1_Click" VerticalAlignment="Center" />
                <Button x:Name="RightStep1" Grid.Column="1" Grid.Row="3" Width="25" HorizontalAlignment="Center" Margin="30,0,0,0" Content="→" FontSize="14" Click="RightStep1_Click" VerticalAlignment="Center" />

                <Button x:Name="LeftStep2" Grid.Column="2" Grid.Row="3" Width="25" HorizontalAlignment="Center" Margin="0,0,30,0" FontSize="14" Content="↓" Click="LeftStep2_Click" VerticalAlignment="Center" />
                <Button x:Name="RightStep2" Grid.Column="2" Grid.Row="3" Width="25" HorizontalAlignment="Center" Margin="30,0,0,0" FontSize="14" Content="↑" Click="RightStep2_Click" VerticalAlignment="Center" />

                <TextBox x:Name="PauInput1" TextWrapping="Wrap" Text="3,0" FontSize="12" Grid.Column="1" Margin="10,0,10,0" Grid.Row="4" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
                <TextBox x:Name="PauInput2" TextWrapping="Wrap" Text="3,0" FontSize="12" Grid.Column="2" Margin="10,0,10,0" Grid.Row="4" VerticalContentAlignment="Center" VerticalAlignment="Center"/>

                <Button x:Name="WalkingStart1" Content="↺" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="5" Grid.Column="1" Width="40" Click="WalkingStart1_Click"/>
                <Button x:Name="WalkingStart2" Content="↺" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="5" Grid.Column="2" Width="40" Click="WalkingStart2_Click"/>

                <TextBox x:Name="TarPosInput1" KeyDown="OnPress" TextWrapping="Wrap" Text="0,0" FontSize="12" Grid.Column="1" Margin="10,0,10,0" Grid.Row="6" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
                <TextBox x:Name="TarPosInput2" KeyDown="OnPress" TextWrapping="Wrap" Text="0,0" FontSize="12" Grid.Column="2" Margin="10,0,10,0" Grid.Row="6" VerticalContentAlignment="Center" VerticalAlignment="Center"/>

                <Label x:Name="MoveLabel" Content="Шаг" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="5,0,5,5" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"/>
                <Label x:Name="PauLabel" Content="Пауза" Grid.Row="4" Grid.Column="0" VerticalContentAlignment="Center" Padding="5,0,5,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Label x:Name="SpeedLabel" Content="Скр" Grid.Row="2" Grid.Column="0" VerticalContentAlignment="Center" Padding="5,0,5,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Label x:Name="TarPosLabel" Content="Ц Поз" Grid.Row="6" Grid.Column="0" VerticalContentAlignment="Center" Padding="5,0,5,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Label x:Name="CurPosLabel" Content="Тек Поз" Grid.Row="0" Grid.Column="0" VerticalContentAlignment="Center" Padding="5,0,5,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Label x:Name="CurPosLabel1" Content="0,0" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" Padding="5,0,5,5" HorizontalAlignment="Center"/>
                <Label x:Name="CurPosLabel2" Content="0,0" Grid.Row="0" Grid.Column="2" VerticalContentAlignment="Center" Padding="5,0,5,5" HorizontalAlignment="Center"/>
                <Label x:Name="TimerLabel" Content="0,0" Grid.Row="8" Grid.Column="0" VerticalContentAlignment="Center" Padding="5,0,5,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button x:Name="TarPosSend1" Content="⌖" HorizontalAlignment="Center" VerticalAlignment="Center" Click="TarPosSend1_Click" Grid.Row="7" Grid.Column="1" Width="40"/>
                <Button x:Name="TarPosSend2" Content="⌖" HorizontalAlignment="Center" VerticalAlignment="Center" Click="TarPosSend2_Click" Grid.Row="7" Grid.Column="2" Width="40"/>
            </Grid>
        </Viewbox>
        <Viewbox x:Name="ChatView" Grid.Column="2" Margin="10,10,10,10" Grid.Row="1">
            <Grid Height="392" Width="380">
                <Grid.RowDefinitions>
                    <RowDefinition Height="95*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="ServerData" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsReadOnly="True" FontFamily="Global Monospace"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60*"/>
                        <ColumnDefinition Width="15*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SendCmd" Content="Отправить" Margin="0,0,0,0" Click="SendCmd_Click" Grid.Column="1"/>
                    <TextBox x:Name="CommandInput" TextWrapping="Wrap" Margin="0,0,0,0" KeyDown="OnPress"/>
                </Grid>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Column="2" Margin="0,0,0,0" Grid.Row="0">
            <Label Content="Сервер" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="28" Height="62" Width="360"/>
        </Viewbox>

    </Grid>
</Window>
